# Base URL (Toggle between live Render deployment and localhost)
@baseUrl = https://lab-02-sqlite-server.onrender.com
# @baseUrl = http://localhost:3000

### 1. GET All Books
# Screenshot: screenshots/get-all-books.png
GET {{baseUrl}}/books/

### 2. GET Single Book
# Screenshot: screenshots/get-single-book.png
GET {{baseUrl}}/books/1/

### 3. POST New Book
# Screenshot: screenshots/post-book.png
POST {{baseUrl}}/books/
Content-Type: application/json

{
  "title": "Clean Architecture",
  "author": "Robert C. Martin",
  "price": 550,
  "pages": 432
}

### 4. PUT Update Book
# Screenshot: screenshots/put-book.png
PUT {{baseUrl}}/books/10/
Content-Type: application/json

{
  "title": "Clean Architecture - Revised Edition",
  "author": "Robert C. Martin",
  "price": 599,
  "pages": 450
}

### 5. DELETE Book
# Screenshot: screenshots/delete-book.png
DELETE {{baseUrl}}/books/10/

### 6. GET Non-Existent Book (404)
# Screenshot: screenshots/invalid-book-404.png
GET {{baseUrl}}/books/99999/

### 7. POST Invalid Input (400)
# Screenshot: screenshots/postman-invalid-input.png
POST {{baseUrl}}/books/
Content-Type: application/json

{
  "title": "",
  "author": "Unknown",
  "price": -10,
  "pages": 0
}
